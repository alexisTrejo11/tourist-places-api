# Tourist Places API — environment template
# Copy to .env and adjust for local dev or AWS (EC2 + RDS).
# Never commit .env with real secrets.

# ---------------------------------------------------------------------------
# Docker Compose profiles
# standalone = app only (external DB/Redis from this file)
# local      = app + Postgres + Redis; override with:
#              COMPOSE_PROFILES=local docker compose up --build
# ---------------------------------------------------------------------------
COMPOSE_PROFILES=standalone

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
SERVER_PORT=8080

# ---------------------------------------------------------------------------
# PostgreSQL (local Docker, or Amazon RDS in production)
# Example RDS URL: jdbc:postgresql://tourist-places.xxxx.eu-west-1.rds.amazonaws.com:5432/tourist_places
# ---------------------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/tourist_places
DB_USERNAME=tourist_user
DB_PASSWORD=change_me_strong_password

# Optional aliases used by docker-compose
DB_NAME=tourist_places

# ---------------------------------------------------------------------------
# JWT (generate a Base64-encoded 256-bit secret for production)
# Example: openssl rand -base64 32
# ---------------------------------------------------------------------------
JWT_SECRET=REPLACE_WITH_BASE64_ENCODED_SECRET_MIN_256_BITS
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# ---------------------------------------------------------------------------
# Redis (local, ElastiCache, or Upstash — token blacklist & activation tokens)
# Spring Boot maps SPRING_DATA_REDIS_* to spring.data.redis.*
# Upstash / ElastiCache TLS: SPRING_DATA_REDIS_SSL_ENABLED=true (not SPRING_DATA_REDIS_SSL)
# ---------------------------------------------------------------------------
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=
SPRING_DATA_REDIS_SSL_ENABLED=false

# ---------------------------------------------------------------------------
# Google OAuth2 (optional — social login)
# Redirect URI must match Google Cloud Console and your EC2/ALB domain
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google

# ---------------------------------------------------------------------------
# SMTP (account activation & password reset emails)
# Production: Amazon SES, SendGrid, or similar
# ---------------------------------------------------------------------------
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-user
MAIL_PASSWORD=your-smtp-password
MAIL_PROTOCOL=smtp
MAIL_CONNECTION_TIMEOUT=5000
MAIL_TIMEOUT=5000
MAIL_WRITE_TIMEOUT=5000
